# Key dari dashboard Midtrans (Settings > Access Keys).
# Key sandbox diawali "SB-". Untuk production, pakai key production dan ubah
# MIDTRANS_IS_PRODUCTION menjadi true.
MIDTRANS_SERVER_KEY=SB-Mid-server-your-sandbox-server-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-sandbox-client-key
MIDTRANS_IS_PRODUCTION=false
PORT=3000
# Jumlah proxy di depan server. Kosongkan saat jalan di komputer sendiri.
# Render dan Railway terdeteksi otomatis; hosting lain di belakang satu proxy
# (mis. Koyeb, Nginx) isi 1. Nilai yang salah membuat rate limit bisa dilewati.
TRUST_PROXY=
# Alamat publik situs setelah deploy, mis. https://fj-coffee.onrender.com.
# Kalau diisi, pembayaran hanya bisa dibuat dari situs ini. Boleh lebih dari
# satu, dipisah koma. Di Render alamat onrender.com sudah dipakai otomatis.
# Kosongkan saat jalan di komputer sendiri.
PUBLIC_URL=
